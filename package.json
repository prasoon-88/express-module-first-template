{
  "name": "express-module-first-template",
  "version": "0.1.0",
  "private": true,
  "description": "Module-first (feature-first) modular monolith starter for Express 5 and TypeScript.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^26.13.0"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node26 --packages=external --sourcemap --outfile=dist/server.js",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check . && knip",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs && eslint --no-inline-config --config eslint.arch.config.mjs src",
    "test": "vitest run",
    "gen:module": "plop module"
  },
  "dependencies": {
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "dependency-cruiser": "18.7.2",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.3",
    "knip": "6.45.1",
    "pino-pretty": "13.2.0",
    "plop": "4.0.5",
    "pluralize": "8.0.0",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
