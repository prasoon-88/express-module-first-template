# Copy to .env for local development: `pnpm dev` loads it when it exists.
# Every variable is optional; the values below are the defaults.
# All of them are validated at boot in src/config/env.ts. An invalid value stops the process.

# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Number of reverse proxies in front of the app (load balancer, ingress). 0 = none.
# Must be correct for rate limiting and logs to see the real client IP.
TRUST_PROXY=0
# Largest accepted JSON request body.
BODY_LIMIT=100kb
# Per client IP: at most RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_MS. Counted per instance.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# How long a graceful shutdown may take before the process is forced to exit.
SHUTDOWN_TIMEOUT_MS=10000

# A pending order expires after this long...
ORDER_PENDING_TTL_MS=900000
# ...and this is how often the expiry job looks for such orders.
EXPIRE_ORDERS_INTERVAL_MS=60000
